# ── Production environment for ChatBot5400 ────────────────────────────────────
# Copy to `.env` next to docker-compose.prod.yml and fill in real values:
#     cp .env.prod.example .env
# NEVER commit the filled-in .env — it holds secrets. (.env is gitignored.)
#
# Generate secrets with:
#     openssl rand -hex 32

# REQUIRED. Encrypts provider API keys stored in the database. If you ever lose
# this value you cannot decrypt previously stored keys — back it up somewhere safe.
OPEN_NOTEBOOK_ENCRYPTION_KEY=

# RECOMMENDED for production. Signs the login JWTs. Setting it lets you rotate the
# JWT signing secret independently of the encryption key. If left blank, the app
# derives a STABLE secret from OPEN_NOTEBOOK_ENCRYPTION_KEY above, so logins still
# survive restarts — sessions only become ephemeral if NEITHER value is set.
OPEN_NOTEBOOK_JWT_SECRET=

# SurrealDB credentials. Change these from root/root before going live — the
# same values configure both the surrealdb and open_notebook services.
SURREAL_USER=root
SURREAL_PASSWORD=

# Public URLs served by Caddy over HTTPS. These are already correct for your
# domains; change them only if the domains change.
PUBLIC_FRONTEND_URL=https://5491sotay.io.vn
PUBLIC_API_URL=https://api.5491sotay.io.vn
