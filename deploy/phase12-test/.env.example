# Phase 12 test stack - copy to .env (never commit .env) and fill every value.
# Use NEW random values: never reuse production credentials.
SURREAL_USER=phase12
SURREAL_PASSWORD=
OPEN_NOTEBOOK_ENCRYPTION_KEY=
OPEN_NOTEBOOK_JWT_SECRET=

# Loopback ports (web / API)
PHASE12_WEB_PORT=8504
PHASE12_API_PORT=5057

# Gate for the Legal Document mode (true = the mode can be chosen in Settings)
OCR_LEGAL_NORMALIZATION_ENABLED=true

# Folders on this machine (relative to deploy/phase12-test)
PHASE12_IMPORT_DIR=./import
PHASE12_OUT_DIR=./diagnostics
# Windows: PHASE12_FONT_DIR=C:/Windows/Fonts
PHASE12_FONT_DIR=./fonts

PHASE12_CPUS=4.0
PHASE12_MEMORY=10g
